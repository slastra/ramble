# LiveKit Configuration
LIVEKIT_KEY=devkey
LIVEKIT_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# File Storage
FILE_STORAGE_MOUNT=./uploads

# Site URL for production
NUXT_PUBLIC_SITE_URL=https://lastra.us

# Browser notifications (Web Push). Generate a pair with: npx web-push generate-vapid-keys
# Leave both empty to turn notifications off.
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use (an https URL or mailto:)
VAPID_SUBJECT=https://ramble.lastra.us
# Where push subscriptions are kept; give it a persistent volume in production
DATA_DIR=./.data/ramble

# AI bots via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Ramble Daemon (optional)
# EVENTS_TOKEN must match `token` in the daemon's ~/.config/ramble/config.toml
EVENTS_TOKEN=
NUXT_PUBLIC_DAEMON_URL=http://localhost:9001
NUXT_PUBLIC_DAEMON_ENABLED=true
